{
  "name": "contextzero-engine",
  "version": "2.9.0",
  "description": "Local code intelligence engine for AI agents with MCP and HTTP interfaces",
  "main": "dist/mcp-interface/index.js",
  "files": [
    "dist/",
    "db/migrations/",
    "db/schema.sql",
    "scripts/create-mcp-config.mjs",
    "scripts/doctor.mjs",
    "scripts/mcp-install.mjs",
    "scripts/setup.mjs",
    "docs/",
    "ARCHITECTURE.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "NOTICE",
    "SECURITY.md",
    "TECHNICAL_DESIGN.md",
    ".env.example",
    ".env.docker.example",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-python-adapter.mjs",
    "start": "node dist/mcp-interface/index.js",
    "dev": "ts-node src/mcp-interface/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "test": "jest",
    "test:db": "node scripts/run-real-db-tests.mjs",
    "test:ci": "jest --ci --coverage --forceExit",
    "test:watch": "jest --watch",
    "ingest": "ts-node src/ingestor/index.ts",
    "db:migrate": "ts-node db/migrate.ts",
    "db:generate-schema": "node scripts/generate-schema.mjs",
    "doctor": "node scripts/doctor.mjs",
    "mcp:config": "node scripts/create-mcp-config.mjs",
    "mcp:install": "node scripts/mcp-install.mjs",
    "setup": "node scripts/setup.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f scg",
    "mcp": "node dist/mcp-bridge/index.js",
    "mcp:dev": "ts-node src/mcp-bridge/index.ts",
    "prestart": "npm run build",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "package:verify": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "release:check": "npm run audit && npm run typecheck && npm run lint && npm run build && npm run test:ci && node scripts/verify-package.mjs",
    "watch": "node dist/watcher/cli.js",
    "watch:dev": "ts-node src/watcher/cli.ts"
  },
  "keywords": [
    "contextzero",
    "code-graph",
    "mcp",
    "code-intelligence",
    "ast",
    "static-analysis",
    "semantic-search",
    "impact-analysis"
  ],
  "author": "ClassEve",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "tree-sitter": "^0.22.4",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "picomatch": "^4.0.4",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2"
  },
  "optionalDependencies": {
    "tree-sitter-bash": "^0.23.3",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.23.11",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "private": true
}
