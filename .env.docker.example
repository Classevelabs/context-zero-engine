# ContextZero Docker configuration
# Copy to .env or run scripts/bootstrap.ps1 -Mode docker / scripts/bootstrap.sh --mode docker.

# Required strong values. Generate with:
#   openssl rand -hex 32
DB_PASSWORD=replace-with-a-strong-postgres-password
SCG_API_KEYS=replace-with-a-strong-32-plus-character-api-key

# Host path mounted into the container at /repos.
SCG_REPOS_PATH=.
SCG_ALLOWED_BASE_PATHS=/repos

# Conservative first-run ingestion limits.
SCG_MAX_FILES_PER_REPO=20000
SCG_MAX_FILE_SIZE_BYTES=1048576
SCG_INGEST_WORKERS=4
SCG_PYTHON_TIMEOUT_MS=30000

# Docker Compose uses a private bridge network between ContextZero and Postgres.
DB_SSL_ALLOW_INSECURE_PRIVATE_NETWORK=true

# Optional browser CORS allowlist for HTTP mode.
SCG_CORS_ORIGINS=
