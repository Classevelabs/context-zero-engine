# ContextZero environment configuration
# Copy to .env and fill in your values.
#
# Sections marked (MCP) apply to the MCP stdio bridge.
# Sections marked (REST) apply to the Express HTTP API.
# Sections marked (BOTH) apply to both.
#
# MCP installers set CONTEXTZERO_ENV_FILE automatically so desktop clients can
# load this file without duplicating secrets in their own config.

# Database (BOTH)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scg_v2
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOYING
DB_MAX_CONNECTIONS=20
# DB_SSL_MODE=disable
# DB_SSL_CA=/absolute/path/to/ca.pem
# Use only for Docker/private-network Postgres where transport stays inside a
# trusted local network. Do not set for a public remote database.
# DB_SSL_ALLOW_INSECURE_PRIVATE_NETWORK=true
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_SLOW_QUERY_MS=500
# Maximum time (ms) a single SQL statement may run before being killed.
# Prevents runaway queries from locking the database. 0 = no limit.
# DB_STATEMENT_TIMEOUT_MS=30000
# Maximum time to wait for the migration advisory lock before startup fails.
# DB_MIGRATION_LOCK_TIMEOUT_MS=10000
# Maximum time a single migration statement may run.
# DB_MIGRATION_STATEMENT_TIMEOUT_MS=300000

# Server (REST)
SCG_PORT=3100
# Loopback is the safe default. Set 0.0.0.0 only behind an intentional network boundary.
SCG_HOST=127.0.0.1

# Runtime mode (BOTH).
#
# `development` suits the local install: one machine, one developer, Postgres
# on localhost.
#
# Use `production` when the REST server is reachable from anything beyond
# localhost. It enforces a strong database password, TLS for remote databases,
# a 32-character minimum on API keys, and refuses to start if an applied
# migration has been modified.
NODE_ENV=development

# Version reported in health checks and logs (BOTH)
# SCG_VERSION=2.6.0

# Authentication (REST)
# Comma-separated API keys. If empty, all requests are rejected.
# Generate with: openssl rand -hex 32
SCG_API_KEYS=your-secret-key-here
# Separate credential for repository mutation, validation command execution,
# transaction control, and /scg_admin_* endpoints. Production refuses overlap.
SCG_ADMIN_API_KEYS=your-distinct-admin-key-here

# MCP is a trusted local stdio child process, not a remotely authenticated
# network service. Per-call secrets are optional defense in depth.
SCG_MCP_AUTH_ENABLED=false
# SCG_MCP_SECRET=generate-a-distinct-high-entropy-secret
# SCG_MCP_ADMIN_SECRET=generate-a-distinct-admin-secret
# MCP tools that mutate state or execute validation commands are off by default.
SCG_MCP_MUTATIONS_ENABLED=false

# Validation commands use a constrained subprocess runner, not a filesystem or
# network sandbox. Enable only for trusted repos under a restricted OS identity.
SCG_ALLOW_UNSANDBOXED_EXECUTION=false

# Security (REST)
# Comma-separated allowed repository base paths.
# Repos outside these paths are rejected. HTTP registration fails closed if empty.
# Windows: SCG_ALLOWED_BASE_PATHS=C:\Repos,D:\Work
# macOS/Linux: SCG_ALLOWED_BASE_PATHS=/home/you/repos,/var/projects
#
# This file does not override a variable that is already set in the process
# environment. If SCG_ALLOWED_BASE_PATHS exists as a system or user environment
# variable, that value wins and editing the line below has no effect. Check with
# `echo $SCG_ALLOWED_BASE_PATHS` (or `$env:SCG_ALLOWED_BASE_PATHS` in PowerShell)
# before assuming the file is being read.
# SCG_ALLOWED_BASE_PATHS=/home/repos,/var/projects
#
# Docker Compose mounts this host directory at /repos and defaults
# SCG_ALLOWED_BASE_PATHS to /repos.
# SCG_REPOS_PATH=/srv/repos

# Comma-separated CORS origins. If empty, no CORS headers are emitted.
# SCG_CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
# Use * only when browser clients from any origin must call the API.
# API key authentication is still required for protected endpoints.
# SCG_CORS_ORIGINS=*

# Set when running behind a reverse proxy/load balancer.
# Examples: true, 1, loopback
# SCG_TRUST_PROXY=true
# Emit HSTS only on HTTPS requests or proxied HTTPS requests.
# SCG_HSTS_MAX_AGE_SECONDS=31536000
# Auto-recover stale non-terminal transactions left behind by crashes.
# SCG_STALE_TRANSACTION_MS=21600000
# SCG_STALE_TRANSACTION_BATCH_SIZE=100

# Logging (BOTH)
# debug | info | warn | error | fatal
LOG_LEVEL=info

# Prerequisites
# PostgreSQL must have the pg_trgm extension installed:
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
# Without it, similarity searches will fail.

# Ingestion safety (BOTH)
# Defaults are intentionally conservative for first-run reliability. Raise
# these after the machine and database are verified with npm run doctor.
SCG_MAX_FILES_PER_REPO=20000
SCG_MAX_FILE_SIZE_BYTES=1048576
SCG_INGEST_WORKERS=4
SCG_PYTHON_TIMEOUT_MS=30000
# Set if "python" or "python3" is not the Python with libcst installed.
# PYTHON_BIN=C:\Python312\python.exe

# Maintenance (BOTH)
# A background pass prunes old snapshots, reclaims orphaned rows, and closes out
# work abandoned by a crash. Defaults are shown; all are optional.
# SCG_RETENTION_ENABLED=true
# SCG_RETENTION_INTERVAL_MINUTES=360
# SCG_SNAPSHOT_MAX_AGE_DAYS=90
# SCG_MAX_SNAPSHOTS_PER_REPO=50
# SCG_ORPHAN_CLEANUP_ENABLED=true
# Minutes before a snapshot still marked `indexing` is treated as abandoned by a
# crashed ingest and marked failed, so the repository stops looking busy.
# SCG_STUCK_INDEXING_TIMEOUT_MINUTES=180
# Minutes before a non-terminal change transaction is considered stale.
# SCG_STALE_TXN_TIMEOUT_MINUTES=60

# Database resilience (BOTH)
# The driver trips a circuit breaker after repeated connection failures instead
# of queuing work against a database that is down. Defaults shown.
# DB_CIRCUIT_FAILURE_THRESHOLD=5
# DB_CIRCUIT_RESET_TIMEOUT_MS=30000
# DB_CIRCUIT_HALF_OPEN_MAX=3

# Metrics (REST)
# Prometheus metrics on /metrics.
# SCG_METRICS_ENABLED=true
